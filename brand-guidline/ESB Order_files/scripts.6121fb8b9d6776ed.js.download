"use strict";var YukkPayment=function(){this.userAgent=navigator.userAgent.toLowerCase(),this.isAndroid=this.userAgent.indexOf("android")>-1,this.isIphone=this.userAgent.indexOf("ios")>-1,this.processPayment=function(e,i){var s={invoiceNumber:e["Charged ID"],transactionAmount:e.Amount,notes:e.Notes};if(this.isAndroid)try{window.MerchantOnline.processPayment(JSON.stringify(s))}catch{}else if(this.isIphone)try{window.webkit.messageHandlers.processPayment.postMessage(JSON.stringify(s))}catch{}}};